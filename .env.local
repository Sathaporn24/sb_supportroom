# Edge TTS (Microsoft Edge Read Aloud) — no API key needed, verified working against the
# real service. facebook/mms-tts-tha (Hugging Face) is not hosted by any inference
# provider anymore, so it was dropped in favor of this.
# Rate -10% picked by the user after comparing samples (A: default, B: -10%, C: male voice).
EDGE_TTS_VOICE=th-TH-PremwadeeNeural
EDGE_TTS_RATE=-10%

