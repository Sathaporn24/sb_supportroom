// SupportRoom AI — PostgreSQL schema
// สร้างจาก EF Core migrations จริง (ถึง 20260811064348_RenameChatSenderRoles) + การแยก
// TrainingLink/LearningSession ที่โค้ดทำแล้วแต่ยังไม่มี migration — อัปเดต 13 ส.ค. 2026
// ⚠️ ตาราง TrainingLink/LearningSession และคอลัมน์ Review* ด้านล่างสะท้อน "โค้ดปัจจุบัน"
//    ไม่ใช่ "ฐานข้อมูลปัจจุบัน" จนกว่าจะรัน migration ที่ค้างอยู่ (ดูท้ายไฟล์)
// วางลง https://dbdiagram.io ได้เลย
//
// ⚠️ ความสัมพันธ์ทุกเส้นด้านล่างเป็น "logical" เท่านั้น
//    ไม่มี FOREIGN KEY จริงในฐานข้อมูล (ไม่มี navigation property ใน OnModelCreating)
//    Ref ที่ประกาศไว้มีไว้ให้ dbdiagram วาดเส้นให้เห็นความสัมพันธ์เชิง domain

Project supportroom {
  database_type: 'PostgreSQL'
  Note: '''
  ห้องเรียนสาธิตด้วยเสียงสำหรับทีม CS ของ School Bright

  ข้อมูลที่ไม่ได้อยู่ในฐานข้อมูลนี้:
  - Vector สำหรับ RAG อยู่ใน Pinecone (นอก PostgreSQL)
    namespace = "{CompanyId}:{LessonSlug}" หรือ "{CompanyId}:kb-global"
    ไม่มีคอลัมน์ใดในฐานข้อมูลนี้ชี้ไปยัง vector id
  - ไฟล์เอกสารจริงอยู่ใน object storage (local disk หรือ Huawei OBS)
    DocumentResource เก็บแค่ metadata + pointer (ObsBucket/ObsKey)
  - เนื้อหาสอน (speaker notes / หน้า PDF) ไม่เคยถูก persist
    resolve สดทุกครั้งจาก Google Slides API หรือไฟล์ PDF
  '''
}

// ทุกตารางมี CompanyId + คอลัมน์ audit ชุดเดียวกันจาก IEntityMaster<string>:
// CreateBy, CreateDate, UpdateBy, UpdateDate, DeleteBy, IsDelete, DeletedAt
// CompanyId มี EF Core global query filter ทุกตาราง (TD-010) — ยกเว้นทางเดียวคือ
// TrainingLinkRepository.GetByToken ที่ต้อง IgnoreQueryFilters เพราะยังไม่รู้ company
// หมายเหตุ: IsDelete/DeletedAt ยังไม่มีพฤติกรรมจริง โค้ดลบแบบ hard delete ทุกครั้ง
//           และไม่มี global query filter

Table LessonConfig {
  Id text [pk, note: 'prefix "lesson_" สร้างโดย IdGenerator']
  CompanyId text [not null]
  CreateBy text [null]
  CreateDate timestamptz [not null]
  UpdateBy text [null]
  UpdateDate timestamptz [null]
  DeleteBy text [null]
  IsDelete boolean [not null]
  DeletedAt timestamptz [null]

  Slug text [not null, note: 'unique ต่อ company ไม่ใช่ทั้งระบบ — สอง company ต้องตั้งชื่อซ้ำกันได้']
  Title text [not null]
  Description text [null]
  SlidesSourceUrl text [not null]
  PresentationId text [null, note: 'derive จาก SlidesSourceUrl ทุกครั้งที่ save']
  SlidesEmbedUrl text [null]
  ContentSourceType text [not null, default: 'google_slides', note: '"google_slides" | "pdf"']
  PdfDocumentResourceId text [null, note: 'ใช้เมื่อ ContentSourceType = "pdf"']
  IntroWaitMs integer [not null]
  BreathPauseMs integer [not null]
  FinalQuestionWaitMs integer [not null]
  SlideConfigs jsonb [null, note: 'EF owned collection ToJson() — [{slideObjectId, slideIndex, videoDurationMs}]']
  IsActive boolean [not null]

  Indexes {
    (CompanyId, Slug) [unique, name: 'IX_LessonConfig_CompanyId_Slug']
  }

  Note: 'เก็บเฉพาะ metadata ที่ admin ตั้ง ห้ามเก็บสำเนาเนื้อหาสอน (architecture rule 8)'
}

Table TrainingLink {
  Id text [pk, note: 'prefix "link_"']
  CompanyId text [not null]
  CreateBy text [null]
  CreateDate timestamptz [not null]
  UpdateBy text [null]
  UpdateDate timestamptz [null]
  DeleteBy text [null]
  IsDelete boolean [not null]
  DeletedAt timestamptz [null]

  Token text [not null, unique, note: 'ลิงก์สาธารณะ — unique ทั้งระบบเพราะถูก lookup ก่อนรู้ company']
  LessonId text [not null]
  LessonSlug text [not null, note: 'denormalized — ประกอบเป็น Pinecone namespace ตอนถามคำถาม']
  RecipientOrgName text [null, note: 'หน่วยงานของผู้รับ (โรงเรียน/สาขา/ฝ่าย) — label เฉย ๆ คนละชั้นกับ CompanyId']
  ExpiresAt timestamptz [not null, note: 'บังคับที่ backend ตอน join — ไม่บล็อกคนที่เรียนค้างอยู่ไม่ให้จบ']
  MaxAttendees integer [null, note: 'null = ไม่จำกัด — มีคอลัมน์ไว้ก่อน ยังไม่บังคับใช้']

  Indexes {
    Token [unique, name: 'IX_TrainingLink_Token']
    CompanyId [name: 'IX_TrainingLink_CompanyId']
  }

  Note: 'ลิงก์ ไม่ใช่การเรียน — 1 แถวเปิดได้หลายคน แต่ละคนได้ LearningSession ของตัวเอง. ไม่มีคอลัมน์ Status: ACTIVE/EXPIRED คำนวณจาก ExpiresAt ตอนอ่าน'
}

Table LearningSession {
  Id text [pk, note: 'prefix "learning_"']
  CompanyId text [not null]
  CreateBy text [null]
  CreateDate timestamptz [not null]
  UpdateBy text [null]
  UpdateDate timestamptz [null]
  DeleteBy text [null]
  IsDelete boolean [not null]
  DeletedAt timestamptz [null]

  TrainingLinkId text [not null]
  LearnerKey text [not null, note: 'key ที่ browser สร้างและเก็บเอง — แยกคนบนลิงก์เดียวกัน + กลับมาเรียนต่อ. ไม่ใช่ credential']
  RecipientName text [not null, note: 'ผู้เรียนกรอกเองตอน join — ไม่ใช่ตัวตน ชื่อซ้ำกันได้']
  Status text [not null, note: '"IN_PROGRESS" | "ENDED" — ไม่มี NOT_STARTED เพราะแถวเกิดตอน join เท่านั้น']
  StartedAt timestamptz [not null]
  EndedAt timestamptz [null]
  LastActivityAt timestamptz [not null, note: '🔴 ตัวเดียวที่ใช้คำนวณ "หยุดกลางคัน" — bump ทุกครั้งที่เปลี่ยนสไลด์']
  LastSlideObjectId text [null]
  LastSlideIndex integer [not null, note: 'เก็บคู่กับ ObjectId เพื่อแสดง "7/20" โดยไม่ต้อง resolve deck ใหม่']
  CompletedAllSlides boolean [not null]

  Indexes {
    (TrainingLinkId, LearnerKey) [name: 'IX_LearningSession_TrainingLinkId_LearnerKey']
    CompanyId [name: 'IX_LearningSession_CompanyId']
  }

  Note: 'การเรียนของคนหนึ่งคน. index ไม่ unique โดยตั้งใจ — กด "เรียนอีกครั้ง" สร้างแถวใหม่ใต้ LearnerKey เดิม. "หยุดกลางคัน" ไม่ใช่คอลัมน์ แต่คำนวณจาก LastActivityAt เทียบ INACTIVE_THRESHOLD_MINUTES ตอนแสดงผล'
}

Table SessionQuestion {
  Id text [pk]
  CompanyId text [not null]
  CreateBy text [null]
  CreateDate timestamptz [not null]
  UpdateBy text [null]
  UpdateDate timestamptz [null]
  DeleteBy text [null]
  IsDelete boolean [not null]
  DeletedAt timestamptz [null]

  SessionId text [not null, note: '→ LearningSession.Id (ไม่ใช่ลิงก์) — คำถามเป็นของคนที่ถาม']
  SlideObjectId text [null]
  Transcript text [null]
  Answer text [null]
  AnswerStatus text [not null, note: '"answered" | "not_found" | "out_of_scope" | "no_speech" | "transcription_failed"']
  ReviewResult text [null, note: '"correct" | "incorrect" — null = CS ยังไม่ตรวจ']
  ReviewNote text [null, note: 'free text ไม่ใช่ enum: "ตอบผิด" มี 3 สาเหตุที่แก้คนละทาง (ไม่มีเอกสาร / ค้นไม่เจอ / AI เดาเอง)']
  ReviewedAt timestamptz [null]

  Indexes {
    SessionId [name: 'IX_SessionQuestion_SessionId']
    CompanyId [name: 'IX_SessionQuestion_CompanyId']
  }

  Note: 'บันทึกคำถาม Push-to-Talk — คำถาม readiness ("พร้อมหรือยัง") ไม่ถูกบันทึกที่นี่. ผู้เรียนไม่เห็นคอลัมน์ Review* — เป็นข้อมูลภายในของ CS'
}

Table ChatMessage {
  Id text [pk]
  CompanyId text [not null]
  CreateBy text [null]
  CreateDate timestamptz [not null]
  UpdateBy text [null]
  UpdateDate timestamptz [null]
  DeleteBy text [null]
  IsDelete boolean [not null]
  DeletedAt timestamptz [null]

  SessionId text [not null, note: '→ LearningSession.Id (ไม่ใช่ลิงก์)']
  SenderRole text [not null, note: '"recipient" | "agent" | "system"']
  SenderName text [null]
  Text text [not null]

  Indexes {
    SessionId [name: 'IX_ChatMessage_SessionId']
    CompanyId [name: 'IX_ChatMessage_CompanyId']
  }

  Note: 'ช่องข้อความสำรอง แยกจาก SessionQuestion — เก็บไว้ให้คนเข้ากลางคันเห็นย้อนหลัง'
}

Table DocumentResource {
  Id text [pk, note: 'prefix "doc_" — chunk id ใน Pinecone คือ "{Id}-{chunkId}"']
  CompanyId text [not null]
  CreateBy text [null]
  CreateDate timestamptz [not null]
  UpdateBy text [null]
  UpdateDate timestamptz [null]
  DeleteBy text [null]
  IsDelete boolean [not null]
  DeletedAt timestamptz [null]

  LessonId text [null, note: '🔴 null = เอกสาร standalone เข้า Pinecone namespace "kb-global" ที่ทุกบทเรียนใช้ร่วมกัน']
  FileName text [not null]
  ContentType text [not null]
  SizeBytes bigint [not null]
  ObsBucket text [not null]
  ObsKey text [not null, note: 'รูปแบบ "documents/{Id}/{FileName}"']
  IndexingStatus text [not null, note: '"pending" | "indexed" | "failed" — ค้างที่ pending ตลอดไปถ้า process restart']
  IndexedChunkCount integer [not null]

  Indexes {
    LessonId [name: 'IX_DocumentResource_LessonId']
    CompanyId [name: 'IX_DocumentResource_CompanyId']
  }
}

// ── ความสัมพันธ์ (logical เท่านั้น ไม่มี FK จริงในฐานข้อมูล) ──

Ref: TrainingLink.LessonId > LessonConfig.Id
Ref: DocumentResource.LessonId > LessonConfig.Id
Ref: LessonConfig.PdfDocumentResourceId - DocumentResource.Id
Ref: LearningSession.TrainingLinkId > TrainingLink.Id
Ref: SessionQuestion.SessionId > LearningSession.Id
Ref: ChatMessage.SessionId > LearningSession.Id

TableGroup lesson_content {
  LessonConfig
  DocumentResource
}

TableGroup invite {
  TrainingLink
}

TableGroup session_runtime {
  LearningSession
  SessionQuestion
  ChatMessage
}

// ──────────────────────────────────────────────────────────────
// migration ที่ยังค้าง — แยก "ลิงก์" ออกจาก "การเรียน" (TD-013, CORE_FEATURE_SPEC)
// โค้ดทุกชั้นทำเสร็จแล้ว แต่ยังไม่ได้สร้าง migration:
//   dotnet ef migrations add SplitTrainingLinkAndLearningSession \
//     --project src/SupportRoom.Providers.Data --startup-project src/SupportRoom.Api
// (ต้องใช้ .NET 10 SDK — เครื่องที่ทำงานล่าสุดมีแค่ SDK 8 จึงยังรันไม่ได้)
//
// 1. rename TrainingSession → TrainingLink
//      ตัดออก: RecipientName, Status, StartedAt, EndedAt, CompletedAllSlides, LastSlideObjectId
//      เพิ่ม:   MaxAttendees integer [null]
//      คงไว้:   Id, CompanyId, Token, LessonId, LessonSlug, RecipientOrgName, ExpiresAt, audit
//
// 2. ตารางใหม่ LearningSession (ดูรายละเอียดคอลัมน์ด้านบน)
//      index (TrainingLinkId, LearnerKey) — ไม่ unique
//
// 3. SessionQuestion — เพิ่ม ReviewResult / ReviewNote / ReviewedAt (nullable ทั้งสาม)
//
// 4. DROP TABLE SessionSummary — ทั้งสามคอลัมน์ซ้ำซ้อนหลังแยกตาราง
//      CompletedAllSlides / LastSlideObjectId ย้ายไป LearningSession
//      UnansweredPoints คำนวณจาก SessionQuestion ที่ AnswerStatus = 'not_found' ตอนอ่าน
//
// 5. ข้อมูลเดิม (ถ้ามีใน environment ไหน) — TrainingSession 1 แถวเดิม = ลิงก์ + การเรียนรวมกัน
//      ต้องแตกเป็น TrainingLink 1 + LearningSession 1 แล้วชี้ SessionQuestion.SessionId /
//      ChatMessage.SessionId ไปที่ LearningSession ที่แตกออกมา
//      LearnerKey ของแถวเก่าไม่มีค่าจริง ให้ generate ใหม่ (คนเดิมกลับมาต่อไม่ได้อยู่แล้ว
//      เพราะ browser ไม่เคยเก็บ key ไว้)
//
// 6. นอกฐานข้อมูล — ไม่มีผลกับ Pinecone namespace (ยังเป็น "{CompanyId}:{LessonSlug}")
// ──────────────────────────────────────────────────────────────
