<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.0" type="device">
  <diagram id="workflow-overview-supportroom" name="Workflow - Overview">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Section labels -->
        <mxCell id="sec1" value="1. Admin/CS ตั้งค่า" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="340" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sec2" value="2. ครูเข้าห้อง" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="340" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sec3" value="3. สอนสด (วนตามสไลด์)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="340" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sec4" value="4. จบ Session" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1560" width="340" height="20" as="geometry" />
        </mxCell>

        <!-- Setup -->
        <mxCell id="b1" value="CS สร้าง Lesson&#10;(Google Slides หรือ PDF, timing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="POST /api/lessons&#10;resolve content source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="Index เนื้อหาลง Knowledge Store&#10;(Embedding + Pinecone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="CS สร้างลิงก์&#10;POST /api/training-links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- Join -->
        <mxCell id="b5" value="เปิด /room/{token}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="GET /api/training-links/{token}&#10;+ lessonTitle&#10;แล้ว POST /learning-sessions/{token}/join" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="PATCH action=start&#10;Status → IN_PROGRESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="เชื่อม SignalR Hub&#10;JoinSession(token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- Live -->
        <mxCell id="bA" value="เล่นคำบรรยายสไลด์&#10;(Google/PDF + Edge TTS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dia1" value="ครูกด&#10;Push-to-Talk?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="990" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b9" value="POST /api/voice-question&#10;audio + slug + sessionId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1130" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b10" value="Gemini ถอดเสียง&#10;Gemini/OpenAI ตอบ (full/RAG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1230" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b11" value="Broadcast ReceiveNewQuestion&#10;→ หน้า Admin (สด)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1330" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b12" value="POST /api/tts&#10;พูดคำตอบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1430" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dia2" value="มีสไลด์&#10;ถัดไป?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="990" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="พิมพ์แชทสำรอง&#10;SendChatMessage ↔ ครู/CS&#10;(ขนานตลอดเวลา)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;dashed=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="1130" width="260" height="90" as="geometry" />
