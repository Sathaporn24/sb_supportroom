        <mxCell id="b13" value="ครูกดจบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1590" width="340" height="60" as="geometry" />
