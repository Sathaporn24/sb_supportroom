# Copy to .env and fill in real values for local Development. .env is gitignored.
# Loaded by DotEnv.Load() at startup (Program.cs). Shell / launchSettings vars override these.
# Every provider below is required - there is no Mock fallback. An unset or invalid value
# throws at startup (see ProviderSelectionReader).

# --- Provider switches (no mock option - see allowed values per category in ProviderSelection.cs) ---
SLIDES_PROVIDER=google
# VOICE_QUESTION_PROVIDER: "gemini" (single call), "gemini-rag" (retrieval, all Gemini), or
# "openai-rag" (Gemini transcribes the audio; OpenAI embeds the query + writes the answer).
VOICE_QUESTION_PROVIDER=gemini-rag
# TTS_PROVIDER: "edge" (free Microsoft Read-Aloud, no key required).
TTS_PROVIDER=edge
# KNOWLEDGE_PROVIDER: "pinecone" (Gemini embeddings) or "pinecone-openai" (OpenAI embeddings, same
# 768-dim index). Must match the vendor every vector was indexed with - switching requires re-index.
KNOWLEDGE_PROVIDER=pinecone
DOCUMENT_STORAGE_PROVIDER=local

# --- Gemini (audio transcription; embeddings when KNOWLEDGE_PROVIDER=pinecone) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- OpenAI-compatible (answer step when VOICE_QUESTION_PROVIDER=openai-rag; embeddings when
#     KNOWLEDGE_PROVIDER=pinecone-openai). Works with OpenAI (platform.openai.com) or any compatible
#     gateway (e.g. GLM on Huawei ModelArts MaaS) via OPENAI_BASE_URL. ---
OPENAI_API_KEY=
# OPENAI_BASE_URL: default https://api.openai.com/v1. For GLM/ModelArts use its /openai/v1 base.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=768   # must equal the Pinecone index dimension
# OPENAI_DISABLE_REASONING: "true" sends thinking:{type:disabled} to skip a reasoning model's
#   thinking pass - faster + cleaner JSON for grounded answers. Only GLM/ModelArts-style endpoints
#   accept it; leave false for a strict OpenAI endpoint.
OPENAI_DISABLE_REASONING=false

# --- Edge TTS (no key required) - used when TTS_PROVIDER=edge ---
EDGE_TTS_VOICE=th-TH-PremwadeeNeural
EDGE_TTS_RATE=-10%

# --- Pinecone (RAG vector index). Host WITHOUT the https:// prefix. ---
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# --- RAG retrieval tuning (both optional, sensible defaults if unset) ---
# RAG_TOP_K: how many chunks to retrieve per question (default 3).
# RAG_MIN_SCORE: minimum cosine score a chunk must clear to count as relevant (default 0.4).
#   Raise it to be stricter (fewer off-topic answers, more "not found"); lower it if real
#   questions are wrongly reported not-found. Watch the per-retrieval scores in the logs to tune.
# RAG_TOP_K=3
# RAG_MIN_SCORE=0.4

# --- Google Slides service account. Share the target deck with the client email (Viewer). ---
# Private key is one line with literal \n escapes, wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- Document storage: local disk (interim) needs no keys. Huawei OBS needs all five below. ---
# LOCAL_STORAGE_PATH=          # defaults to <Api project>/storage
# HUAWEI_OBS_ENDPOINT=
# HUAWEI_OBS_ACCESS_KEY=
# HUAWEI_OBS_SECRET_KEY=
# HUAWEI_OBS_BUCKET=
# HUAWEI_OBS_REGION=

# --- Dev conveniences ---
ALLOW_DATA_RESET=true
