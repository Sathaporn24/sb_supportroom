# Copy to .env and fill in real values for local Development. .env is gitignored.
# Loaded by DotEnv.Load() at startup (Program.cs). Shell / launchSettings vars override these.
# Every provider below is required - there is no Mock fallback. An unset or invalid value
# throws at startup (see ProviderSelectionReader).

# --- Provider switches (no mock option - see allowed values per category in ProviderSelection.cs) ---
SLIDES_PROVIDER=google
VOICE_QUESTION_PROVIDER=gemini-rag
# TTS_PROVIDER: "edge" (free, no key) or "elevenlabs" (needs the ElevenLabs block below).
TTS_PROVIDER=edge
KNOWLEDGE_PROVIDER=pinecone
DOCUMENT_STORAGE_PROVIDER=local

# --- Gemini (voice question + embeddings) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Edge TTS (no key required) - used when TTS_PROVIDER=edge ---
EDGE_TTS_VOICE=th-TH-PremwadeeNeural
EDGE_TTS_RATE=-10%

# --- ElevenLabs TTS - used when TTS_PROVIDER=elevenlabs ---
# API key: ElevenLabs dashboard -> Profile -> API Keys. VoiceId: dashboard -> Voices (pick a
# multilingual voice for Thai). Model defaults to eleven_multilingual_v2 if unset.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Pinecone (RAG vector index). Host WITHOUT the https:// prefix. ---
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# --- RAG retrieval tuning (both optional, sensible defaults if unset) ---
# RAG_TOP_K: how many chunks to retrieve per question (default 3).
# RAG_MIN_SCORE: minimum cosine score a chunk must clear to count as relevant (default 0.4).
#   Raise it to be stricter (fewer off-topic answers, more "not found"); lower it if real
#   questions are wrongly reported not-found. Watch the per-retrieval scores in the logs to tune.
# RAG_TOP_K=3
# RAG_MIN_SCORE=0.4

# --- Google Slides service account. Share the target deck with the client email (Viewer). ---
# Private key is one line with literal \n escapes, wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- Document storage: local disk (interim) needs no keys. Huawei OBS needs all five below. ---
# LOCAL_STORAGE_PATH=          # defaults to <Api project>/storage
# HUAWEI_OBS_ENDPOINT=
# HUAWEI_OBS_ACCESS_KEY=
# HUAWEI_OBS_SECRET_KEY=
# HUAWEI_OBS_BUCKET=
# HUAWEI_OBS_REGION=

# --- Dev conveniences ---
ALLOW_DATA_RESET=true
