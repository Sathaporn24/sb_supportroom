# Copy to .env and fill in real values for local Development. .env is gitignored.
# Loaded by DotEnv.Load() at startup (Program.cs). Shell / launchSettings vars override these.
# Every provider below is required - there is no Mock fallback. An unset or invalid value
# throws at startup (see ProviderSelectionReader).

# --- Database / browser origins ---
# Local Docker Compose overrides this with the internal `postgres` hostname. Native `dotnet run`
# should point it at whichever local PostgreSQL instance you use.
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=supportroom;Username=postgres;Password=postgres
# Comma-separated browser origins. Development always includes http://localhost:3000; set this
# when using another local port or when configuring a non-development environment.
# ALLOWED_ORIGINS=http://localhost:3000

# --- Provider switches (no mock option - see allowed values per category in ProviderSelection.cs) ---
SLIDES_PROVIDER=google
# VOICE_QUESTION_PROVIDER: "gemini" (single call), "gemini-rag" (retrieval, all Gemini), or
# "openai-rag" (Gemini transcribes the audio; OpenAI embeds the query + writes the answer).
VOICE_QUESTION_PROVIDER=gemini-rag
# TTS_PROVIDER: "edge" (free Microsoft Read-Aloud, no key required).
TTS_PROVIDER=edge
# KNOWLEDGE_PROVIDER: "pinecone" (Gemini embeddings) or "pinecone-openai" (OpenAI embeddings, same
# 768-dim index). Must match the vendor every vector was indexed with - switching requires re-index.
KNOWLEDGE_PROVIDER=pinecone
DOCUMENT_STORAGE_PROVIDER=local

# --- Gemini (audio transcription; embeddings when KNOWLEDGE_PROVIDER=pinecone) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- OpenAI-compatible (answer step when VOICE_QUESTION_PROVIDER=openai-rag; embeddings when
#     KNOWLEDGE_PROVIDER=pinecone-openai). Works with OpenAI (platform.openai.com) or any compatible
#     gateway (e.g. GLM on Huawei ModelArts MaaS) via OPENAI_BASE_URL. ---
OPENAI_API_KEY=
# OPENAI_BASE_URL: default https://api.openai.com/v1. For GLM/ModelArts use its /openai/v1 base.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=768   # must equal the Pinecone index dimension
# OPENAI_DISABLE_REASONING: "true" sends thinking:{type:disabled} to skip a reasoning model's
#   thinking pass - faster + cleaner JSON for grounded answers. Only GLM/ModelArts-style endpoints
#   accept it; leave false for a strict OpenAI endpoint.
OPENAI_DISABLE_REASONING=false

# --- Edge TTS (no key required) - used when TTS_PROVIDER=edge ---
EDGE_TTS_VOICE=th-TH-PremwadeeNeural
EDGE_TTS_RATE=-10%

# --- Pinecone (RAG vector index). Host WITHOUT the https:// prefix. ---
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# --- RAG retrieval tuning (both optional, sensible defaults if unset) ---
# RAG_TOP_K: how many chunks to retrieve per question (default 3).
# RAG_MIN_SCORE: minimum cosine score a chunk must clear to count as relevant (default 0.4).
#   Raise it to be stricter (fewer off-topic answers, more "not found"); lower it if real
#   questions are wrongly reported not-found. Watch the per-retrieval scores in the logs to tune.
# RAG_TOP_K=3
# RAG_MIN_SCORE=0.4

# --- Google Slides service account. Share the target deck with the client email (Viewer). ---
# Private key is one line with literal \n escapes, wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- Document storage: local disk (interim) needs no keys. Huawei OBS needs all five below. ---
# LOCAL_STORAGE_PATH=          # defaults to <Api project>/storage
# HUAWEI_OBS_ENDPOINT=
# HUAWEI_OBS_ACCESS_KEY=
# HUAWEI_OBS_SECRET_KEY=
# HUAWEI_OBS_BUCKET=
# HUAWEI_OBS_REGION=

# --- Learning session behaviour (all optional, sensible defaults if unset) ---
# DEFAULT_INTRO_WAIT_MS=5000
# DEFAULT_BREATH_PAUSE_MS=500
# DEFAULT_FINAL_QUESTION_WAIT_MS=5000
# DEFAULT_SESSION_EXPIRY_HOURS: how long a new training link stays usable (default 24).
# INACTIVE_THRESHOLD_MINUTES: a learner who has not changed slide in this long is DISPLAYED as
#   "หยุดกลางคัน" (default 30). Never written to the database - it is computed at read time,
#   because the browser signal that would set a stored flag is missed exactly when it matters
#   (closed laptop, dead battery, lost connection). Changing it re-labels existing sessions
#   immediately, with no migration and nothing to backfill.
# DEFAULT_SESSION_EXPIRY_HOURS=24
# INACTIVE_THRESHOLD_MINUTES=30

# --- Upload limits (optional) ---
# MAX_VOICE_UPLOAD_MB=5
# MIN_VOICE_DURATION_MS=300
# MAX_DOCUMENT_UPLOAD_MB=20

# --- Back-office authentication (TD-014) ---
# JWT_SECRET is REQUIRED and the app refuses to start without it. No default on purpose: a
# fallback would mean every deployment that forgot to set it shares a key printed in this repo.
# At least 32 characters - HMAC-SHA256 rejects anything shorter. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
# JWT_ISSUER=supportroom
# JWT_AUDIENCE=supportroom-admin
# JWT_EXPIRY_MINUTES: also how long a deactivated account keeps working, since there is no
#   refresh token yet. Default 480 (one working day).
# JWT_EXPIRY_MINUTES=480

# The first owner account, created at startup ONLY when no account exists at all - otherwise
# nobody could sign in to create the first one. It is forced to change this password on first
# sign-in, because whoever deployed can read it here. Safe to leave unset once accounts exist.
# FIRST_OWNER_EMAIL=
# FIRST_OWNER_PASSWORD=
# FIRST_OWNER_NAME=

# ALLOW_COMPANY_HEADER / DEFAULT_COMPANY_ID are GONE - do not re-add them. They let any caller
# choose which company a request read by setting a header, which was tolerable only while every
# user was School Bright staff. Now that customers' own people sign in, a request's company comes
# from a verified JWT plus an authorization check (CurrentUserMiddleware), or from
# TrainingLink.Token on the learner side.

# --- Dev conveniences ---
# ALLOW_DATA_RESET only unlocks /api/admin/reset and /api/admin/reindex; both ALSO require the
# owner role, so this flag alone no longer exposes them.
ALLOW_DATA_RESET=true
