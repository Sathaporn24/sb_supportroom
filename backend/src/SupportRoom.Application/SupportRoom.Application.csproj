    <ProjectReference Include="..\SupportRoom.Providers.DocumentParsing\SupportRoom.Providers.DocumentParsing.csproj" />
    <ProjectReference Include="..\SupportRoom.Providers.Knowledge\SupportRoom.Providers.Knowledge.csproj" />
    <ProjectReference Include="..\SupportRoom.Providers.Slides\SupportRoom.Providers.Slides.csproj" />
