# Repo-wide ignores. Frontend-specific patterns live in frontend/.gitignore;
# backend-specific ones in backend/.gitignore.

# OS
.DS_Store
Thumbs.db

# logs
*.log

# stray generated files (real ones live under frontend/ or backend/)
*.tsbuildinfo
next-env.d.ts

# secrets / local env (belt-and-suspenders across the whole repo)
.env
.env*.local
*.pem

.next/
node_modules/

# personal working notes - not part of the product repo (e.g. docs/THESIS_PLAN.local.md)
*.local.md

# scratch space for generating handoff artifacts (rendered page images, build scripts).
# The generated PDF under output/ is a deliverable and stays tracked; the 1.6 MB of
# intermediate JPEGs that produced it are not.
tmp/.claude/settings.local.json
