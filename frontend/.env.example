# SB_Ai_Supportroom (.NET backend) base URL - every /api/... call and the SignalR hub
# connection in api-client.ts go here instead of this app's own route handlers.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5138

# This is intentionally the only frontend environment variable. Provider switches, credentials,
# upload limits, JWT settings and tutor defaults belong in backend/src/SupportRoom.Api/.env.
# Never add a secret with NEXT_PUBLIC_ - Next.js ships those values to every browser.
