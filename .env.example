# SB_Ai_Supportroom (.NET backend) base URL - every /api/... call and the SignalR hub
# connection in api-client.ts go here instead of this app's own route handlers.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5138

# Provider switches — server-only, default mock (no keys needed to run the app)
DATA_PROVIDER=mock
SLIDES_PROVIDER=mock
TTS_PROVIDER=mock
VOICE_QUESTION_PROVIDER=mock

# Google Slides — server only. See docs/GOOGLE_SLIDES_SETUP.md
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Edge TTS (Microsoft Edge Read Aloud) — no API key needed. Thai neural voice by default;
# override with any voice ShortName (e.g. th-TH-NiwatNeural for a male voice).
# Rate accepts SSML rate values (e.g. "-10%", "slow"); -10% tested as sounding more natural.
EDGE_TTS_VOICE=th-TH-PremwadeeNeural
EDGE_TTS_RATE=-10%

# Gemini — server only. See docs/GEMINI_INTEGRATION.md
GEMINI_API_KEY=
GEMINI_MODEL=

# Upload / request limits
MAX_VOICE_UPLOAD_MB=5
MIN_VOICE_DURATION_MS=300

# Tutor defaults (applied when a LessonConfig doesn't override them)
DEFAULT_INTRO_WAIT_MS=5000
DEFAULT_BREATH_PAUSE_MS=500
DEFAULT_FINAL_QUESTION_WAIT_MS=5000
DEFAULT_SESSION_EXPIRY_HOURS=24
